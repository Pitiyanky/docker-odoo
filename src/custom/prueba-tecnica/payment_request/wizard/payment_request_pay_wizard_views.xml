<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_request_pay_wizard_form" model="ir.ui.view">
        <field name="name">payment.request.pay.wizard.form</field>
        <field name="model">payment.request.pay.wizard</field>
        <field name="arch" type="xml">
            <form string="Emitir Pago a Proveedor">
                <sheet>
                    <group>
                        <group string="Datos de Solicitud">
                            <field name="request_id" readonly="1"/>
                            <field name="partner_id"/>
                            <field name="amount_request"/>
                            <field name="currency_request_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group string="Datos Contables del Desembolso">
                            <field name="journal_id"/>
                            <field name="payment_date"/>
                            <field name="payment_currency_id" invisible="1"/>
                            <field name="payment_amount" readonly="1" decoration-bf="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button string="Generar Pago" type="object" name="action_confirm_payment" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
