<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_request_list" model="ir.ui.view">
        <field name="name">payment.request.list</field>
        <field name="model">payment.request</field>
        <field name="arch" type="xml">
            <list string="Solicitudes de Pago" 
                  decoration-info="state == 'draft'" 
                  decoration-warning="state == 'to_approve'" 
                  decoration-success="state in ('approved', 'paid')" 
                  decoration-danger="state == 'rejected'">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id"/>
                <field name="requester_id"/>
                <field name="amount" sum="Total"/>
                <field name="currency_id"/>
                <field name="approver_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_payment_request_form" model="ir.ui.view">
        <field name="name">payment.request.form</field>
        <field name="model">payment.request</field>
        <field name="arch" type="xml">
            <form string="Solicitud de Pago">
                <header>
                    <button name="action_submit" string="Enviar Solicitud" type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Aprobar Paso" type="object" class="btn-success"
                            groups="payment_request.group_payment_request_approver,payment_request.group_payment_request_manager"
                            invisible="state != 'to_approve'"/>
                    <button name="action_reject_wizard" string="Rechazar" type="object" class="btn-danger"
                            groups="payment_request.group_payment_request_approver,payment_request.group_payment_request_manager"
                            invisible="state != 'to_approve'"/>
                    <button name="action_pay_wizard" string="Generar Pago a Proveedor" type="object" class="btn-primary"
                            groups="payment_request.group_payment_request_treasury,payment_request.group_payment_request_manager"
                            invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,to_approve,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Solicitud"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Detalles del Requerimiento">
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="state != 'draft'"/>
                            <field name="concept" readonly="state != 'draft'"/>
                        </group>
                        <group string="Control y Secuencia">
                            <field name="requester_id"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="policy_id" invisible="not policy_id"/>
                            <label for="current_step" string="Progreso" invisible="state not in ('to_approve', 'approved', 'paid')"/>
                            <div class="o_row" invisible="state not in ('to_approve', 'approved', 'paid')">
                                <span>Paso </span>
                                <field name="current_step" class="oe_inline"/>
                                <span> de </span>
                                <field name="total_steps" class="oe_inline"/>
                            </div>
                            <field name="approver_id" invisible="state not in ('to_approve')"/>
                            <field name="approved_by_id" invisible="not approved_by_id"/>
                            <field name="approval_date" invisible="not approval_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="payment_id" invisible="not payment_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Historial de Validaciones">
                            <field name="historical_ids">
                                <list create="false" edit="false" delete="false">
                                    <field name="step_number" string="Paso"/>
                                    <field name="step_name" string="Fase / Rol"/>
                                    <field name="user_id" string="Aprobado Por"/>
                                    <field name="date" string="Fecha y Hora"/>
                                </list>
                            </field>
                        </page>
                        <page string="Motivo de Rechazo" invisible="state != 'rejected'">
                            <field name="rejection_reason" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_payment_request_search" model="ir.ui.view">
        <field name="name">payment.request.search</field>
        <field name="model">payment.request</field>
        <field name="arch" type="xml">
            <search string="Buscar Solicitudes">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="requester_id"/>
                <filter name="filter_draft" string="Borrador" domain="[('state', '=', 'draft')]"/>
                <filter name="filter_to_approve" string="En Aprobación" domain="[('state', '=', 'to_approve')]"/>
                <filter name="filter_approved" string="Aprobadas" domain="[('state', '=', 'approved')]"/>
                <filter name="filter_paid" string="Pagadas" domain="[('state', '=', 'paid')]"/>
                <separator/>
                <filter name="filter_my_requests" string="Mis Solicitudes" domain="[('requester_id', '=', uid)]"/>
                <group name="group_by">
                    <filter name="group_partner" string="Proveedor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Fecha" context="{'group_by': 'date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_payment_request" model="ir.actions.act_window">
        <field name="name">Solicitudes de Pago</field>
        <field name="res_model">payment.request</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_my_requests': 1}</field>
    </record>
</odoo>
